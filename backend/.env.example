# Provider Selection
LLM_PROVIDER=local  # Options: local, groq, openrouter
VECTOR_DB_PROVIDER=chroma  # Options: chroma, pinecone

# Ollama (local LLM)
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-70b-instruct
OPENROUTER_APP_NAME=NutriRAG
OPENROUTER_APP_URL=http://localhost:8000

# Pinecone (cloud vector DB)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=nutri-rag
